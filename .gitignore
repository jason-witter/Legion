# Scratch directory (preserve structure, ignore contents)
scratch/**
!scratch/**/
!scratch/**/.gitkeep

# The archive holds relocated content and is regenerated; keep it fully ignored,
# including .gitkeep placeholders that travel in when live directories are archived.
scratch/output/archive/**
